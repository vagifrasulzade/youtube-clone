# Copy to .env and replace every "change-me" value.
# deploy.sh creates .env automatically with random secrets.
# Use URL-safe characters only (letters, digits, - _): passwords are embedded in URLs.

APP_ENV=production
LOG_LEVEL=INFO

POSTGRES_USER=youtube
POSTGRES_PASSWORD=change-me
POSTGRES_DB=youtube

# Two different random values, 32+ characters each (production refuses weak/equal ones).
JWT_SECRET=change-me-jwt-secret
MEDIA_TOKEN_SECRET=change-me-media-secret
# true only when the site is served over HTTPS
COOKIE_SECURE=false

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me-minio
# Application user created by minio-init (the API never uses the root account).
MINIO_APP_ACCESS_KEY=youtube-app
MINIO_APP_SECRET_KEY=change-me-minio-app
# MINIO_IMAGE=cgr.dev/chainguard/minio@sha256:<digest>

# Development host ports (docker-compose.dev.yml)
DEV_POSTGRES_PORT=5433
DEV_REDIS_PORT=6380
DEV_MINIO_PORT=9000
DEV_MINIO_CONSOLE_PORT=9001
DEV_API_PORT=8080
