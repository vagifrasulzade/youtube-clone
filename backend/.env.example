# Host development settings (copy to backend/.env). Ports match docker-compose.dev.yml.
# Use 127.0.0.1, not localhost: on Windows "localhost" tries IPv6 ::1 first and stalls.
ENV=development
LOG_JSON=false
DATABASE_URL=postgresql+psycopg://youtube:<POSTGRES_PASSWORD from ../.env>@127.0.0.1:5433/youtube
REDIS_URL=redis://127.0.0.1:6380/0
CORS_ORIGINS=["http://localhost:5173"]
